# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/toyovoindia

CLIENT_URL=http://localhost:5173
CLIENT_URL_PROD=https://your-production-frontend-domain.com
SERVER_URL=http://localhost:5000
VERCEL_PROJECT_SLUG=toyove-india-jhkr

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- PayU ---
PAYU_KEY=
PAYU_SALT=
PAYU_MID=
PAYU_BASE_URL=https://secure.payu.in

# --- PhonePe ---
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_ENV=UAT
PHONEPE_AUTH_URL=
PHONEPE_PG_URL=

# --- JioPay (UAT) ---
# Merchant ID and Secret Key are issued by JioPay per environment (UAT vs production).
# Never hardcode JIOPAY_SECRET_KEY in source — it must only ever live here / in the host's env vars.
JIOPAY_MERCHANT_ID=JP2001100068230
JIOPAY_SECRET_KEY=
JIOPAY_ENV=uat
JIOPAY_BASE_URL=https://uat.jiopay.co.in
JIOPAY_INITIATE_SALE_PATH=/tsp/pg/api/v2/initiateSale
JIOPAY_COMMAND_PATH=/tsp/pg/api/command
JIOPAY_CURRENCY_CODE=356

# --- Airpay ---
AIRPAY_MERCHANT_ID=
AIRPAY_CLIENT_ID=
AIRPAY_SECRET_KEY=
AIRPAY_USERNAME=
AIRPAY_PASSWORD=
AIRPAY_API_KEY=
AIRPAY_BASE_URL=https://payments.airpay.co.in/pay/index.php
AIRPAY_VERIFY_URL=https://payments.airpay.co.in/order/verify.php
AIRPAY_CURRENCY_CODE=356

# --- DeekPay (Star2Pay) ---
DEEKPAY_MERCHANT_ID=81
DEEKPAY_MERCHANT_ACCOUNT=DKKA999
DEEKPAY_MERCHANT_KEY=
DEEKPAY_BASE_URL=https://deekpayapi.star2pay.net
DEEKPAY_ORDER_CREATE_PATH=/v1.0/api/order/create
DEEKPAY_ORDER_QUERY_PATH=/v1.0/api/order/query
DEEKPAY_COLLECTION_PRODUCT_ID=3021
DEEKPAY_DISBURSEMENT_PRODUCT_ID=3020
DEEKPAY_CALLBACK_IPS=13.127.130.180,3.108.117.248,3.108.167.137,3.6.5.154,13.127.187.82,13.232.167.96,43.213.141.71,43.213.57.217

# --- HDFC SmartGateway (Juspay-powered) ---
# API key comes from the SmartGateway dashboard under Settings > API Keys (NOT the dashboard login password).
# Never hardcode HDFC_API_KEY in source — it must only ever live here / in the host's env vars.
HDFC_API_KEY=
HDFC_MERCHANT_ID=SG6240
HDFC_PAYMENT_PAGE_CLIENT_ID=hdfcmaster
HDFC_RESELLER_ID=hdfc_reseller
HDFC_ENV=sandbox
HDFC_BASE_URL=https://smartgateway.hdfcuat.bank.in
HDFC_API_VERSION=2023-06-30
HDFC_CURRENCY_CODE=INR
# Set these to any username/password you choose, then enter the SAME pair in
# SmartGateway Dashboard > Webhook Settings > Basic HTTP Authorization so inbound webhooks can be verified.
HDFC_WEBHOOK_USERNAME=
HDFC_WEBHOOK_PASSWORD=

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase (JSON string) ---
FIREBASE_CONFIG=
