{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.toyovoindia.com/api/$1" },
    { "source": "/payment/airpay/response", "destination": "https://api.toyovoindia.com/api/payments/airpay/response" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
